# Configuration for the inline LLM agent (Agent.scala).
#
# Copy this file to `env.sh` and fill in your API key:
#
#     cp env.sh.example env.sh
#
# `env.sh` is gitignored, so your key never gets committed. The agent reads
# these variables at startup (see Agent.scala); `start.sh` sources this file.

# ── Required ─────────────────────────────────────────────────────────────────

# API key for the OpenAI-compatible chat-completions endpoint.
export AGENT_API_KEY="sk-..."

# ── Provider / model ─────────────────────────────────────────────────────────

# Base URL of the OpenAI-compatible API (without the /chat/completions suffix).
export AGENT_BASE_URL="https://api.deepseek.com"

# Model name to request.
export AGENT_MODEL="deepseek-v4-flash"

# ── Reasoning ────────────────────────────────────────────────────────────────

# Turn reasoning on: on/1/true/yes/enabled. Unset (or anything else) = off.
export AGENT_THINKING="on"

# How "reasoning on" is encoded in the request body:
#   effort          -> reasoning_effort + thinking:{type:enabled}  (most providers)
#   enable_thinking -> a single enable_thinking:true flag, no effort knob
export AGENT_THINKING_STYLE="effort"

# reasoning_effort level when AGENT_THINKING_STYLE=effort (e.g. low/medium/high).
export AGENT_EFFORT="high"

# Sampling temperature. Leave unset for the provider default; set to 0.0 for
# greedy decoding. Reasoning models may ignore it.
# export AGENT_TEMPERATURE="0.0"

# ── Agent behaviour ──────────────────────────────────────────────────────────

# Hard cap on nested agent[...] recursion depth (default 32 when unset).
export AGENT_MAX_DEPTH="128"

# Max attempts (initial try plus retries) per agent[...] call before it gives
# up (default 8 when unset).
# export AGENT_MAX_ATTEMPTS="8"

# Feed the recent REPL transcript into each call (default on). Set to "off" to
# answer each call independently, so one call's transcript never leaks into
# another's prompt.
# export AGENT_REPL_HISTORY="on"
